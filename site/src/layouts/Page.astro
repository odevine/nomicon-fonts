---
import '../styles/marks.css';
import '../styles/global.css';
import { groups, href, pages } from '../lib/site';

interface Props { title: string; description?: string }
const { title, description = 'A text face revival with real printing imperfections, digitized from printed trading cards.' } = Astro.props;
const full = title === 'Nomicon Fonts' ? title : `${title} · Nomicon Fonts`;
const current = Astro.url.pathname;
const faces = [
  ['400-normal', 400, 'normal'],
  ['400-italic', 400, 'italic'],
  ['600-normal', 600, 'normal'],
].map(([f, w, s]) => `@font-face{font-family:'Stand-in Serif';src:url('${href(`/fonts/eb-garamond-latin-${f}.woff2`)}') format('woff2');font-weight:${w};font-style:${s};font-display:swap}`).join('')
  // the site is set in its own face, whose Weight axis runs from 400 to a semibold at 600
  + [['regular', 'normal'], ['italic', 'italic']].map(([f, s]) => `@font-face{font-family:'Nomicon Rules';src:url('${href(`/fonts/nomicon-rules-${f}.woff`)}') format('woff');font-weight:400 600;font-style:${s};font-display:swap}`).join('');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={href('/favicon.ico')} sizes="32x32" />
    <link rel="preload" href={href('/fonts/nomicon-rules-regular.woff')} as="font" type="font/woff" crossorigin />
    <style is:inline set:html={faces}></style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <a class="mark" href={href('/')}>Nomicon Fonts</a>
      <nav aria-label="Main">
        {groups.map(([g, label]) => (
          <div class="nav-group">
            <span class="nav-label" id={`nav-${g}`}>{label}</span>
            <ul aria-labelledby={`nav-${g}`}>
              {pages.filter((p) => p.group === g && !p.hidden).map((p) => (
                <li><a href={href(p.path)} aria-current={current.startsWith(href(p.path)) ? 'page' : undefined}>{p.title}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site">
      <p>Nomicon Fonts is unofficial Fan Content permitted under the Fan Content Policy. Portions of the materials used are property of Wizards of the Coast. ©Wizards of the Coast LLC.</p>
      <p>Card scans aren’t published. This site only shows derived outlines, measurements and small captioned crops.</p>
      <p>{pages.filter((p) => p.group === 'site').map((p) => <a href={href(p.path)} aria-current={current.startsWith(href(p.path)) ? 'page' : undefined}>{p.title}</a>)}</p>
    </footer>
  </body>
</html>
