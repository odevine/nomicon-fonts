---
import Page from '../../layouts/Page.astro';
import { readdirSync } from 'node:fs';
import { glyphs, glyph, sweepOf, noise, noisePair, cards, calibration, edgeLevels, fileSize, fmt, kerning, meta, corners } from '../../lib/data';
import { cardName, glyphLabel, countWord, capital } from '../../lib/format';
import { href } from '../../lib/site';
import { SM, sweepAxes } from '../../lib/sweepmap';

const n = noise(), cal = calibration(), lv = edgeLevels();
const hist = n.headline.hist;
const last = hist.counts.reduce((m, c, i) => (c ? i : m), 0);
const Hn = last + 3, H = { w: 560, h: 240, l: 44, r: 12, t: 12, b: 40 };
const cmax = Math.max(...hist.counts);
const hx = (u: number) => H.l + (u / (Hn * hist.bin_um)) * (H.w - H.l - H.r);
const hy = (c: number) => H.h - H.b - (c / cmax) * (H.h - H.t - H.b);
const hticks = Array.from({ length: Math.floor((Hn * hist.bin_um) / 5) + 1 }, (_, i) => i * 5);
const e = glyph('e');
const enough = glyphs().filter((r) => r.n >= meta().min_instances).length;
const { lead } = noisePair();
const figures = [
  [String(e.n), `printed e's, from ${e.cards.length} cards`, '/glyphs/e/'],
  [String(enough), `glyphs with at least ${meta().min_instances} instances`, '/glyphs/'],
  [`${fmt(lead.single_scan_um)} µm`, `single-scan edge noise, ${fmt(lead.pair_mean_um)} µm for the mean of two views`, '#noise'],
  [fmt(cal.summary.px_per_mm, 2), 'scanner pixels per millimetre', '#calibration'],
  [`${fmt(lv.min, 2)}–${fmt(lv.max, 2)}`, `edge level that matched ink area across ${lv.scans} scans`, '#edge-levels'],
] as const;
const w = cal.edge_w1090_um;
const files = [
  ['glyphs.json', 'Glyph index: name, instances, cards, nodes, edge RMS, IoU, and whether the trace leans on the measuring stick'],
  ['glyphs/{name}.json', 'Per glyph: trace, mean contours 0.1 to 0.9, spread grid, up to 64 instance paths, cutaways'],
  ['sweep/{name}.json', 'Edge RMS and noise against the number of stacked instances'],
  ['built.json', 'Glyphs with no stack of their own, what each is built from and the print look it’s drawn with'],
  ['kerning.json', 'Observed spacing for each adjacent pair, with the designed value'],
  ['kerning_samples.json', 'Every measured gap behind kerning.json, by scan'],
  ['metrics.json', 'The measuring stick’s vertical metrics and space width'],
  ['meta.json', 'The instance counts behind the prior and the low confidence marks'],
  ['noise.json', 'Comparison of views of the same printed glyph scanned at different angles'],
  ['calibration.json', 'Scale, isotropy, edge widths from the calibration scans'],
  ['cards.json', 'Cards, their scans, edge levels and print scale'],
  ['corners.json', 'Edge offsets at the measuring stick’s corners by face and angle, and the Bleed page close ups'],
  ['steps/', 'Crops and figures for the cleaning steps'],
  ['pixels/', 'One small raw crop and its registered coverage per glyph, for the Stack’s pixel layers'],
];
const gl = readdirSync('data/glyphs').length;
const rows = glyphs();
const byCount = [...rows].sort((a, z) => z.n - a.n || a.name.localeCompare(z.name));
// the sweep overview: every glyph's curve, its y axis cut at the 99th percentile so a few one-instance outliers don't flatten it
const sweeps = byCount.map((r) => ({ r, sw: sweepOf(r.name) }));
const smN = Math.max(...sweeps.flatMap(({ sw }) => sw.rows.map((w) => w.n)));
const smV = sweeps.flatMap(({ sw }) => sw.rows.map((w) => w.p90)).sort((a, z) => a - z);
const smY = Math.ceil(smV[Math.floor(smV.length * 0.99)] / 4) * 4;
const ax = sweepAxes(smN, smY);
const pick = byCount.find((r) => r.name === 'e') ?? byCount[0];
const pd = glyph(pick.name), psw = sweepOf(pick.name);
const pickLabel = glyphLabel(pick.char, pick.style);
const priorN = rows.filter((r) => r.source === 'prior').length;
const MIN_PAIR = 5;
const pairs = Object.entries(kerning()).sort((a, z) => z[1].n - a[1].n);
const kb = (f: string) => `${Math.round(fileSize(f) / 1024)} KB`;
const sizes: Record<string, string> = {
  'glyphs.json': `${fileSize('glyphs.json')} B`, 'kerning.json': `${Math.round(fileSize('kerning.json') / 1024)} KB`,
  'noise.json': `${fileSize('noise.json')} B`, 'calibration.json': `${fileSize('calibration.json')} B`, 'cards.json': `${fileSize('cards.json')} B`,
  'built.json': kb('built.json'), 'kerning_samples.json': kb('kerning_samples.json'), 'metrics.json': `${fileSize('metrics.json')} B`, 'meta.json': `${fileSize('meta.json')} B`, 'corners.json': kb('corners.json'),
};
---
<Page title="Data" description="Every data file, how to reproduce it, and the limits.">
  <article class="flow">
    <p class="kicker">Reference</p>
    <h1>Data</h1>
    <p class="lede">Every number on this site comes from a file in <span class="mono">site/data</span>, and <span class="mono">glyphstack.export_site</span> writes those files, apart from the corner measurements, which <span class="mono">glyphstack.corners</span> writes.</p>

    <ul class="figures wide">
      {figures.map(([big, cap, to]) => (
        <li><span class="big"><a href={to.startsWith('#') ? to : href(to)}>{big}</a></span><span class="cap">{cap}</span></li>
      ))}
    </ul>
    <p class="proof">These come from one scanner and {Object.keys(cards()).length} cards, each scanned at 0° and 90°. The scans are read with the texture profile, which levels tinted text boxes and averages out a strong halftone screen. The scanner blurs edges over 100 to 125 µm, so stacking reduces noise but doesn’t recover finer detail.</p>

    <nav class="toc wide" aria-label="On this page">
      <div><p class="kicker">Method</p><ul><li><a href="#calibration">Calibration</a></li><li><a href="#noise">Noise</a></li><li><a href="#edge-levels">Edge levels</a></li><li><a href="#corners">Corners</a></li><li><a href="#limits">Limits</a></li></ul></div>
      <div><p class="kicker">Data</p><ul><li><a href="#glyphs">Glyphs</a></li><li><a href="#stacking">Stacking</a></li><li><a href="#spacing">Spacing</a></li><li><a href="#files">Files</a></li></ul></div>
    </nav>

    <p class="kicker part" id="method">Method</p>
    <h2 id="calibration">Calibration</h2>
    <p>Ruler ticks on the calibration target give {fmt(cal.summary.px_per_mm, 2)} px/mm, with x and y scales equal to {fmt(cal.summary.scan_anisotropy * 100, 2)} %. Edge widths measured on slanted printed edges range {fmt(Math.min(...w), 0)} to {fmt(Math.max(...w), 0)} µm over {w.length} edges, median {fmt(cal.summary.edge_w1090_um_median, 0)} µm. The scanner pixel is 21 µm, so the blur is several pixels wide.</p>

    <div class="scroll wide" tabindex="0" role="region" aria-label="Ruler fits table">
      <table>
        <caption>Scale from each ruler on the calibration target. Scan A has the sheet upright, scan B has it turned 90°.</caption>
        <thead><tr><th>Scan and paper axis</th><th class="r">Ticks</th><th class="r">px per mm</th><th class="r">Tilt °</th><th class="r">Fit residual px</th></tr></thead>
        <tbody>{(['a', 'b'] as const).flatMap((s) => (['x', 'y'] as const).map((ax) => { const r = cal.rulers[s][ax]; return <tr><th scope="row">Scan {s.toUpperCase()}, paper {ax}</th><td class="r">{r.ticks}</td><td class="r">{fmt(r.px_per_mm, 3)}</td><td class="r">{fmt(r.tilt_deg, 2)}</td><td class="r">{fmt(r.resid_px, 2)}</td></tr>; }))}</tbody>
      </table>
    </div>
    <div class="scroll wide" tabindex="0" role="region" aria-label="Tone steps table">
      <table>
        <caption>Grey level read for each printed tone step, 0 is black and 255 is white</caption>
        <thead><tr><th>Percent black printed</th>{cal.tone_percent_black.map((p) => <th class="r">{p}</th>)}</tr></thead>
        <tbody><tr><th scope="row">Scan A</th>{cal.tone.a.map((v) => <td class="r">{fmt(v, 0)}</td>)}</tr><tr><th scope="row">Scan B</th>{cal.tone.b.map((v) => <td class="r">{fmt(v, 0)}</td>)}</tr></tbody>
      </table>
    </div>

    <h2 id="noise">Noise</h2>
    <p>Two views of the same printed glyph, scanned at different angles, differ by an edge RMS of {fmt(n.headline.pair_rms_um)} µm over {n.headline.n_pairs} pairs, with scale and shear tied across a card’s scans. That gives {fmt(n.headline.single_scan_um)} µm single-scan noise and {fmt(n.headline.pair_mean_um)} µm for a pair mean.</p>
    <p>Fitting each scan’s affine on its own instead gives {fmt(n.alternative.single_scan_um)} µm and {fmt(n.alternative.pair_mean_um)} µm over {n.alternative.n_pairs} pairs.</p>

    <figure class="hist-fig">
      <svg class="hist" viewBox={`0 0 ${H.w} ${H.h}`} role="img" aria-labelledby="hs-t hs-d">
        <title id="hs-t">How far apart the two copies of each printed glyph are</title>
        <desc id="hs-d">A histogram of the edge distance between two views of each of {hist.n} printed glyphs. The middle pair differs by {fmt(hist.median_um)} micrometres.</desc>
        {hist.counts.slice(0, Hn).map((c, i) => c > 0 && <rect class="bar" x={hx(i * hist.bin_um) + 1} y={hy(c)} width={hx(hist.bin_um) - hx(0) - 2} height={hy(0) - hy(c)} />)}
        <line class="axis" x1={H.l} x2={H.w - H.r} y1={hy(0)} y2={hy(0)} />
        {hticks.map((u) => <text class="axt" x={hx(u)} y={H.h - H.b + 16} text-anchor="middle">{u}</text>)}
        <text class="axt" x={(H.l + H.w - H.r) / 2} y={H.h - 6} text-anchor="middle">edge distance between the two copies, µm</text>
        <line class="med" x1={hx(hist.median_um)} x2={hx(hist.median_um)} y1={H.t} y2={hy(0)} />
      </svg>
      <figcaption>{hist.n} printed glyphs, each scanned twice. Dashed line: the middle pair, {fmt(hist.median_um)} µm. The RMS over all pairs is {fmt(hist.rms_um)} µm.</figcaption>
    </figure>

    <h2 id="edge-levels">Edge levels</h2>
    <p>To reproduce the same pooled ink area, each of the {lv.scans} scans needed its own coverage level, from {fmt(lv.min, 2)} to {fmt(lv.max, 2)}.</p>

    <h2 id="corners">Corners</h2>
    <p>At each corner of the measuring stick’s outline, a ray runs along the bisector out of the ink. The offset is where the stack’s edge crosses it, less where the sharp outline spread by the face’s ink spread crosses it, positive with the ink further out. Inner corners fill and outer corners round, more the sharper the corner. The last column is the same offset measured from the edge of the face’s print look, which is what the look leaves over. Only glyphs traced from their own copies count.</p>
    <div class="scroll wide" tabindex="0" role="region" aria-label="Corner offsets table">
      <table id="corner-table">
        <caption>Median edge offset at each corner by face, kind and angle, from corners.json. The angle is the opening of an outer corner’s ink or of an inner corner’s white wedge.</caption>
        <thead><tr><th>Face and corner</th><th class="r">Angle °</th><th class="r">Corners</th><th class="r">Offset µm</th><th class="r">Left by the look µm</th></tr></thead>
        <tbody>{Object.entries(corners()).flatMap(([face, c]) => c.bins.map((b) => <tr><th scope="row">{capital(face)}, {b.kind}</th><td class="r">{b.lo} to {b.hi}</td><td class="r">{b.n}</td><td class="r">{fmt(b.stack_um, 0)}</td><td class="r">{fmt(b.left_um, 0)}</td></tr>))}</tbody>
      </table>
    </div>

    <h2 id="limits">Limits</h2>
    <p>Everything here comes from one scanner and {countWord(Object.keys(cards()).length)} cards, with an optical blur of 100 to 125 µm. The ink spread is relative to the pooled edge level, not an absolute physical measurement, and the numbers comparing the stack against the design depend on one fit shared by every letter of a face. A glyph marked (prior) has fewer than {meta().min_instances} instances and is blended with the measuring stick, so its figures lean toward the design.</p>

    <p class="kicker part" id="data">Data</p>
    <h2 id="glyphs">Glyphs</h2>
    <form class="filters wide" data-for="glyph-table" hidden>
      <label>Find <input type="search" name="q" size="6" autocomplete="off" /></label>
      <fieldset><legend class="vh">Face</legend>
        <label><input type="radio" name="face" value="" checked /> Both faces</label>
        <label><input type="radio" name="face" value="regular" /> Regular</label>
        <label><input type="radio" name="face" value="italic" /> Italic</label>
      </fieldset>
      <label><input type="checkbox" name="noprior" checked /> Hide the {priorN} glyphs blended with the prior</label>
      <p class="count" aria-live="polite"></p>
    </form>
    <div class="scroll wide" tabindex="0" role="region" aria-label="Glyph statistics table">
      <table data-sortable id="glyph-table">
        <caption>Statistics for each glyph, from glyphs.json. Edge RMS and IoU are against the measuring stick. Sorted by instances. Select a column heading to sort by another, or a recommended N for that glyph’s stacking numbers.</caption>
        <thead><tr><th data-type="text">Glyph</th><th class="r" aria-sort="descending">Instances</th><th class="r">Cards</th><th class="r">Nodes</th><th class="r">Edge RMS µm</th><th class="r">IoU</th><th class="r">Recommended N</th></tr></thead>
        <tbody>{byCount.map((r) => <tr data-char={r.char} data-face={r.style} data-prior={r.source === 'prior' ? '' : undefined}><th scope="row" data-v={glyphLabel(r.char, r.style)}><a href={href(`/glyphs/${r.name}/`)}>{glyphLabel(r.char, r.style)}</a>{r.source === 'prior' ? ' (prior)' : r.low_confidence ? ' (low confidence)' : ''}</th><td class="r" data-v={r.n}>{r.n}</td><td class="r" data-v={r.cards}>{r.cards}</td><td class="r" data-v={r.nodes}>{r.nodes}</td><td class="r" data-v={r.edge_rms_um ?? ''}>{fmt(r.edge_rms_um, 2)}</td><td class="r" data-v={r.iou ?? ''}>{fmt(r.iou, 3)}</td><td class="r" data-v={r.recommended_n ?? ''}><a href={`#glyph-${r.name}`} aria-label={`${r.recommended_n}, stacking numbers for ${glyphLabel(r.char, r.style)}`}>{r.recommended_n}</a></td></tr>)}</tbody>
      </table>
    </div>

    <h2 id="stacking">Stacking, glyph by glyph</h2>
    <p>Each grey line is one glyph’s edge error against the measuring stick as more of its instances are stacked, from a sweep over random subsets. Most fall toward a floor set by the scanner’s blur, and the glyphs with only a handful of instances stop early on the left. The picked glyph is drawn in red with its p10 to p90 band, and its tables follow.</p>
    <stack-panel class="wide" data-base={href('/data/')} data-nmax={smN} data-ymax={smY}>
      <form class="filters" hidden>
        <label for="sp-glyph">Glyph</label>
        <select id="sp-glyph">{byCount.map((r) => <option value={r.name} selected={r.name === pick.name}>{glyphLabel(r.char, r.style)}, {r.n} {r.n === 1 ? 'instance' : 'instances'}</option>)}</select>
      </form>
      <figure class="sweepmap">
        <svg viewBox={`0 0 ${SM.W} ${SM.H}`} role="img" aria-labelledby="sm-t sm-d">
          <title id="sm-t">Edge error against the number of stacked instances, for every glyph</title>
          <desc id="sm-d">{sweeps.length} curves of edge RMS in micrometres against N on a log axis. The picked glyph, {pickLabel}, is drawn in red.</desc>
          <defs><clipPath id="sm-clip"><rect x={SM.l} y={SM.t} width={SM.W - SM.l - SM.r} height={SM.H - SM.t - SM.b} /></clipPath></defs>
          {ax.yticks.map((v) => <line class="grid" x1={SM.l} x2={SM.W - SM.r} y1={ax.Y(v)} y2={ax.Y(v)} />)}
          <g clip-path="url(#sm-clip)">
            <g class="curves">{sweeps.map(({ r, sw }) => <path data-name={r.name} d={ax.line(sw.rows, 'rms_vs_ref_um')} />)}</g>
            <g class="sel"><path class="band" d={ax.band(psw.rows)} /><path class="noise" d={ax.line(psw.rows, 'noise_model_um')} /><path class="rms" d={ax.line(psw.rows, 'rms_vs_ref_um')} /><line class="rec" x1={ax.X(psw.recommended_n)} x2={ax.X(psw.recommended_n)} y1={SM.t} y2={SM.H - SM.b} /></g>
          </g>
          <line class="axis" x1={SM.l} x2={SM.W - SM.r} y1={SM.H - SM.b} y2={SM.H - SM.b} />
          {ax.xticks.map((t) => <text x={ax.X(t)} y={SM.H - SM.b + 16} text-anchor="middle">{t}</text>)}
          {ax.yticks.map((v) => <text x={SM.l - 6} y={ax.Y(v) + 4} text-anchor="end">{v}</text>)}
        </svg>
        <figcaption>Edge RMS in µm, against N instances stacked on a log scale. Red: <span class="sm-name">{pickLabel}</span>. Dashed blue: its modelled noise. Red rule: its recommended N. The axis stops at {smY} µm, which cuts off a few curves that start above it.</figcaption>
      </figure>
      <h3 class="sp-head"><span class="sm-name">{pickLabel}</span>, <span class="sp-n">{pick.n}</span> instances</h3>
      <div class="sp-tables">
        <div class="scroll" tabindex="0" role="region" aria-label="Traces table">
          <table><caption>Trace from the first N instances of one fixed random order</caption>
            <thead><tr><th class="r">N</th><th class="r">Cards</th><th class="r">Nodes</th><th class="r">Edge RMS µm</th></tr></thead>
            <tbody class="sp-trace">{pd.trace_by_n.map((t) => <tr><td class="r">{t.n}</td><td class="r">{t.cards}</td><td class="r">{t.nodes}</td><td class="r">{t.edge_rms_um === null ? 'n/a' : fmt(t.edge_rms_um, 2)}</td></tr>)}</tbody></table>
        </div>
        <div class="scroll" tabindex="0" role="region" aria-label="N-sweep table">
          <table><caption>N-sweep over random subsets, µm</caption>
            <thead><tr><th class="r">N</th><th class="r">Edge RMS</th><th class="r">p10</th><th class="r">p90</th><th class="r">Noise model</th></tr></thead>
            <tbody class="sp-sweep">{psw.rows.map((t) => <tr><td class="r">{t.n}</td><td class="r">{fmt(t.rms_vs_ref_um, 2)}</td><td class="r">{fmt(t.p10, 2)}</td><td class="r">{fmt(t.p90, 2)}</td><td class="r">{fmt(t.noise_model_um, 2)}</td></tr>)}</tbody></table>
        </div>
      </div>
    </stack-panel>

    <h2 id="spacing">Observed spacing</h2>
    <p>These are the gaps between adjacent letters as measured on the cards, in font units (1 fu is about 3.1 µm), against the designed gap with and without its kern value. A pair seen only a few times says little, so pairs with fewer than {MIN_PAIR} samples start hidden.</p>
    <form class="filters wide" data-for="spacing-table" hidden>
      <label>Fewest samples <input type="number" name="min" min="1" value={MIN_PAIR} size="3" /></label>
      <p class="count" aria-live="polite"></p>
    </form>
    <div class="scroll wide" tabindex="0" role="region" aria-label="Observed spacing table">
      <table data-sortable id="spacing-table">
        <caption>{pairs.length} pairs, most measured first. Select a column heading to sort by another.</caption>
        <thead><tr><th data-type="text">Pair</th><th class="r" aria-sort="descending">Samples</th><th class="r">Designed gap</th><th class="r">Kern</th><th class="r">Mean deviation before kern</th><th class="r">After kern</th><th class="r">sd</th></tr></thead>
        <tbody>{pairs.map(([k, v]) => <tr data-n={v.n}><td class="mono" data-v={k}>{k}</td><td class="r" data-v={v.n}>{v.n}</td><td class="r" data-v={v.designed_gap ?? ''}>{fmt(v.designed_gap, 0)}</td><td class="r" data-v={v.kern ?? ''}>{v.kern}</td><td class="r" data-v={v.mean_dev_nokern ?? ''}>{fmt(v.mean_dev_nokern)}</td><td class="r" data-v={v.mean_dev_kern ?? ''}>{fmt(v.mean_dev_kern)}</td><td class="r" data-v={v.sd ?? ''}>{fmt(v.sd)}</td></tr>)}</tbody>
      </table>
    </div>

    <h2 id="files">Files</h2>
    <div class="scroll wide" tabindex="0" role="region" aria-label="Data files table">
      <table>
        <caption>Contents of site/data, {glyphs().length} glyphs, {gl} glyph files. Files with .italic in the name hold the same for the italic face.</caption>
        <thead><tr><th>File</th><th>Content</th><th class="r">Size</th></tr></thead>
        <tbody>{files.map(([f, d]) => <tr><td class="mono">{f}</td><td>{d}</td><td class="r">{sizes[f] ?? ''}</td></tr>)}</tbody>
      </table>
    </div>
  </article>
</Page>
<script>import '../../scripts/sorttable'; import '../../scripts/datapage';</script>
<style is:global>
  .hist-fig { margin: 1rem 0; }
  .hist { width: 100%; max-width: 560px; height: auto; display: block; }
  .hist .bar { fill: var(--ink); fill-opacity: 0.8; }
  .hist .axis { stroke: var(--ink); stroke-width: 1; }
  .hist .med { stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .hist .axt { font-family: var(--label); font-variant-numeric: lining-nums tabular-nums; font-style: italic; font-size: 14px; fill: var(--muted); }
  .hist-fig figcaption { font-size: 0.85rem; color: var(--muted); }
</style>
