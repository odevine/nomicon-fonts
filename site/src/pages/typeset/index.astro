---
import Page from '../../layouts/Page.astro';
import { cards } from '../../lib/data';
import { spacingTable } from '../../../integrations/spacing.mjs';
import { href } from '../../lib/site';

const sp = spacingTable();
// a rules line from a scanned card that uses only scanned glyphs, so the page without scripts sets all of it
const DEFAULT = 'Whenever you draw a card, Niv-Mizzet, the Firemind deals 1 damage to target creature or player.';
const italic = Object.keys(sp.glyphs).filter((k) => k.startsWith('i:')).length;
const regular = Object.keys(sp.glyphs).length - italic;
---
<Page title="Typeset" description="Set your own text in the printed letters and in Nomicon Rules.">
  <p class="kicker">Set your own text</p>
  <h1>Typeset</h1>
  <p class="lede">Type below to set it in Nomicon Rules, the font this site is set in. A letter with enough printed copies is the trace of their stack, and the rest stand in from the measuring stick, drawn with the print look, until more cards are scanned.{italic > 0 && ' Text between asterisks is set in the italic face used for flavor and reminder text.'}</p>
  <type-setter class="wide" data-base={href('/data/')} data-preview={href('/fonts/')} data-default={DEFAULT}>
    <figure class="set-out">
      <p class="set-static">{DEFAULT}</p>
      <figcaption>Without scripts the phrase is set as plain text in the font. With them, you can change the text.</figcaption>
    </figure>
  </type-setter>
  <p class="proof">Only {regular} regular{italic > 0 && ` and ${italic} italic`} glyphs have traces so far, from {Object.keys(cards()).length} cards. A character the font doesn’t have shows as a dashed cell. The image you download is a picture of the set text, not the outlines.</p>
</Page>
<script>import '../../scripts/typeset';</script>
<style is:global>
  .setter textarea { width: 100%; font: inherit; font-size: 1.1rem; background: var(--fill); color: var(--ink); border: 0; border-radius: var(--r-md); padding: 0.8rem 1.1rem; resize: vertical; }
  .setter .samples { font-size: 0.85rem; margin: 0.6rem 0 1rem; }
  .setter .samples .btn { margin: 0 0.4rem 0.4rem 0; }
  .setter-controls { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: end; }
  /* one row per font axis, the name, slider and value each in a column so the sliders line up */
  .setter .axes { flex: 1 1 22rem; max-width: 36rem; margin: 0; border: 0; background: var(--fill); border-radius: var(--r-lg); padding: 0.1rem 1.25rem 0.9rem; }
  .setter .axes legend { float: left; width: 100%; font-family: var(--label); font-style: italic; font-size: 0.9rem; color: var(--muted); padding: 0.9rem 0 0.1rem; }
  .setter .axes legend + * { clear: both; }
  .setter .axes .nrow { display: grid; grid-template-columns: 3.5rem 1fr 3.5rem; margin: 0.6rem 0 0; max-width: none; }
  .setter .axes .nrow output { text-align: right; }
  .setter-controls .toggles { margin: 0; }
  .setter .actions { margin: 0; display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .btn:disabled { opacity: 0.5; cursor: default; }
  .set-out { margin: 2rem 0 0.5rem; background: var(--fill); border-radius: var(--r-lg); padding: 1.5rem 1.75rem; }
  .set-svg { display: block; width: 100%; height: auto; }
  .set-svg path, .set-svg text { fill: var(--ink); }
  .set-static { margin: 0; font-size: 48px; line-height: 1.2; }
  .ts-preview .bleed-row { max-width: 24rem; }
  .set-svg .ghost rect { fill: none; stroke: var(--ink); stroke-opacity: 0.65; stroke-width: 9; stroke-dasharray: 26 18; }
  .set-out figcaption { font-size: 0.8rem; color: var(--muted); }
</style>
